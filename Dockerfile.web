# Multi-stage: Node to build the Angular bundle, nginx (unprivileged, non-root) to serve it.
#
# Pinned to 22.23.2, not the floating `node:22` or `node:22-alpine` tag — Angular 22's CLI
# hard-refuses any Node below 22.22.3, and a floating tag is only safe until it next moves.

FROM node:22.23.2-alpine AS build
WORKDIR /app

# Restore before copying source, so npm ci is cached across source-only edits.
COPY src/Portfolio.Web/package.json src/Portfolio.Web/package-lock.json ./
RUN npm ci

COPY src/Portfolio.Web/ ./
RUN npm run build -- --configuration production

# nginx:alpine's own image runs its master process as root by default (workers drop to `nginx`
# via the `user nginx;` directive, but the container itself does not) — every step below exists
# to make the CONTAINER non-root too, per the project's non-root rule, without switching away
# from the nginx:alpine base the stack is documented to use.
FROM nginx:1.31-alpine AS final

RUN rm /etc/nginx/conf.d/default.conf \
    && mkdir -p /var/cache/nginx/client_temp \
                /var/cache/nginx/proxy_temp \
                /var/cache/nginx/fastcgi_temp \
                /var/cache/nginx/uwsgi_temp \
                /var/cache/nginx/scgi_temp \
    && chown -R nginx:nginx /var/cache/nginx /var/log/nginx /run \
    && touch /run/nginx.pid \
    && chown nginx:nginx /run/nginx.pid

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/Portfolio.Web/browser /usr/share/nginx/html

USER nginx

# >1024 so a non-root process can bind it; matches ASPNETCORE_HTTP_PORTS on the api side and the
# host publish mapping in compose.yaml.
EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
