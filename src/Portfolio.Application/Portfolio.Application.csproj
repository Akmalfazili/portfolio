<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Portfolio.Domain\Portfolio.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Provider-agnostic EF Core abstractions only (no SqlServer/InMemory provider reference here).
      This gives IQueryable/Select projection support and the async LINQ operators
      (ToListAsync, SumAsync, ...) used against IPortfolioDbContext, while the concrete provider
      stays a Portfolio.Infrastructure concern.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <!--
      BackgroundService/IHostedService only — pure hosting-lifecycle abstractions, not ASP.NET
      Core. No HTTP-client or SignalR type is pulled in by this package, so the "nothing web-y
      leaks into Application" rule still holds for PriceRefreshBackgroundService.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
