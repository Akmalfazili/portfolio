# Copy to .env and fill in real values. .env is gitignored — never commit it.

# SQL Server container SA password.
# Must satisfy SQL Server complexity rules (8+ chars, upper, lower, digit, symbol)
# or the db container will exit on startup with an unhelpful error.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# Stock + FX market data — free tier, no card required.
# Sign up: https://twelvedata.com/pricing  (800 credits/day, 8 req/min)
TwelveData__ApiKey=

# Crypto market data — free Demo tier.
# Sign up: https://www.coingecko.com/en/api  (30 calls/min, 10k/month)
CoinGecko__ApiKey=
