# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- SQL Server credentials — TWO distinct logins, do not reuse one for the other ---
#
# BOOTSTRAP ONLY. Used exclusively by the one-shot `migrate` service (Dockerfile.migrate) to
# apply EF Core migrations and to create the portfolio_app login below. The api container is
# never given this password and never connects as sa (D29). Must satisfy SQL Server complexity
# rules (8+ chars, 3 of: upper/lower/digit/symbol) or the db container exits on startup with an
# unhelpful error.
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass

# THE APP'S OWN LOGIN. Used by the api container's ConnectionStrings__Portfolio at runtime.
# The migrate service creates this SQL login + database user for you on first run, granted only
# db_datareader + db_datawriter (no DDL) — same complexity rules as above apply.
MSSQL_APP_PASSWORD=ChangeMe_App_Str0ng!Pass

# --- Market data provider keys ---

# Stock + FX market data — free tier, no card required.
# Sign up: https://twelvedata.com/pricing  (800 credits/day, 8 req/min)
TwelveData__ApiKey=

# Crypto market data — free, keyless public API works fine; leave this blank unless you have a
# paid CoinGecko Pro/Demo key. Sign up: https://www.coingecko.com/en/api
#
# ⚠ Known caveat (undecided, tracked as D32 — not a container-stack defect, a provider-routing
# one): Portfolio.Infrastructure routes to the paid pro-api.coingecko.com whenever this value is
# present at all, even as an empty string — and under compose, a blank `KEY=` line in .env IS
# "present" as far as the container's environment is concerned, unlike an entirely-unset
# `dotnet user-secrets` key locally. Leaving this blank under Docker will 401 against the Pro
# API rather than silently falling back to the free api.coingecko.com endpoint. Harmless (crypto
# quotes just don't refresh) but worth knowing rather than debugging cold. Fix belongs in
# Portfolio.Infrastructure/DependencyInjection.cs (`string.IsNullOrWhiteSpace` instead of
# `is null`), a backend-dotnet change — see tracker.md.
CoinGecko__ApiKey=
